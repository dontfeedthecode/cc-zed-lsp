{
  "name": "cc-zed-lsp",
  "private": true,
  "version": "0.1.0",
  "description": "Zed extension and language server for Claude Code SKILL.md files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dontfeedthecode/cc-zed-lsp.git"
  },
  "homepage": "https://github.com/dontfeedthecode/cc-zed-lsp#readme",
  "bugs": {
    "url": "https://github.com/dontfeedthecode/cc-zed-lsp/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "docs:sync": "tsx packages/docs-sync/src/cli.ts --write",
    "docs:check": "tsx packages/docs-sync/src/cli.ts --check",
    "check:versions": "node scripts/check-versions.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
